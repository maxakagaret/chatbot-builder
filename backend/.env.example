APP_NAME="Chatbot Builder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker Compose defaults (see ../docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=chatbot
DB_USERNAME=chatbot
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Chatbot -----------------------------------------------------------------
# Idle conversations older than this restart from the start step.
CHATBOT_SESSION_TTL=30
CHATBOT_QUEUE=chatbot
# HMAC secret for messenger/SMS webhooks — replace in any shared environment.
CHATBOT_WEBHOOK_SECRET=change-me
